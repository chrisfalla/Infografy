---
import '../styles/global.css';
import Hero from '../components/Hero.astro';
import PerfilAcademico from '../components/PerfilAcademico.astro';
import AreaInteres from '../components/AreaInteres.astro';
import Habilidades from '../components/Habilidades.astro';
import Herramientas from '../components/Herramientas.astro';
import Intereses from '../components/Intereses.astro';
import Proyeccion from '../components/Proyeccion.astro';
import IdentidadDigital from '../components/IdentidadDigital.astro';
import Footer from '../components/Footer.astro';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Mi Perfil e Identidad Profesional Digital - Estudiante de Diseño de Modas" />
    <title>Mi Perfil Profesional | Diseño de Modas</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Raleway:wght@300;400;500;600&display=swap" rel="stylesheet">
  </head>
  <body>
    <Hero />
    <PerfilAcademico />
    <AreaInteres />
    <Habilidades />
    <Herramientas />
    <Intereses />
    <Proyeccion />
    <IdentidadDigital />
    <Footer />
  </body>
</html>
