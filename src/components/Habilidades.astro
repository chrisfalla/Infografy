<style>
  .habilidades {
    background: var(--color-white);
  }

  .habilidades-grid {
    max-width: 1000px;
    margin: 0 auto;
  }

  .habilidad-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 1.5rem 1rem;
    border-radius: 12px;
    transition: all 0.3s ease;
    cursor: default;
  }

  .habilidad-item:hover {
    background: var(--color-bg-cream);
    transform: translateY(-3px);
  }

  .habilidad-icon {
    width: 50px;
    height: 50px;
    background: linear-gradient(135deg, var(--color-accent-gold), var(--color-accent-dark));
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
    transition: transform 0.3s ease;
  }

  .habilidad-item:hover .habilidad-icon {
    transform: scale(1.1);
  }

  .habilidad-icon svg {
    width: 24px;
    height: 24px;
    fill: var(--color-white);
  }

  .habilidad-name {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.4;
  }

  @media (max-width: 768px) {
    .habilidades-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .habilidad-item {
      padding: 1rem 0.5rem;
    }

    .habilidad-icon {
      width: 45px;
      height: 45px;
    }

    .habilidad-name {
      font-size: 0.85rem;
    }
  }

  @media (max-width: 480px) {
    .habilidades-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
